    <string name="capture_input_microphone">麦克风</string>
    <string name="capture_input_both">系统声音和麦克风</string>
    <string name="capture_input_help">开始前选择音源。系统声音与麦克风使用独立的识别会话和字幕，同时开启可能分别产生服务费用。切换音源前请先停止。</string>
    <string name="microphone_permission_hint">请允许使用麦克风以翻译你的语音。</string>
    <string name="microphone_source_hint">翻译运行时，麦克风声音会发送到所选识别服务。同时采集系统声音时，建议使用耳机，避免麦克风再次录入扬声器声音。</string>
    <string name="microphone_no_sound_hint">未检测到麦克风语音，请检查麦克风并靠近说话。</string>
    <string name="microphone_ready_hint">麦克风已就绪，说话后即可查看字幕。</string>
    <string name="notification_microphone_text">正在翻译麦克风声音</string>
    <string name="capture_both_source_hint">系统声音和麦克风正在分别采集。</string>
    <string name="guide_selected_input">开始后会将所选音源（%1$s）发送到识别服务。</string>
    <string name="guide_microphone_states">悬浮窗：%1$s\n麦克风：%2$s</string>
    <string name="guide_microphone_steps">请允许悬浮窗和麦克风权限。仅翻译麦克风声音时无需共享屏幕。</string>
    <string name="guide_microphone_trial">说一句简短的话</string>
