<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="capture_input_label">音源</string>
    <string name="capture_input_system">系統聲音</string>
    <string name="capture_input_microphone">麥克風</string>
    <string name="capture_input_both">系統聲音和麥克風</string>
    <string name="capture_input_help">開始前選擇音源。系統聲音與麥克風使用獨立的辨識工作階段和字幕，同時開啟可能分別產生服務費用。切換音源前請先停止。</string>
    <string name="microphone_permission_hint">請允許使用麥克風以翻譯你的語音。</string>
    <string name="microphone_source_hint">翻譯執行時，麥克風聲音會傳送到所選辨識服務。同時擷取系統聲音時，建議使用耳機，避免麥克風再次錄入喇叭聲音。</string>
    <string name="microphone_no_sound_hint">未偵測到麥克風語音，請檢查麥克風並靠近說話。</string>
    <string name="microphone_ready_hint">麥克風已就緒，說話後即可查看字幕。</string>
    <string name="notification_microphone_text">正在翻譯麥克風聲音</string>
    <string name="capture_both_source_hint">系統聲音和麥克風正在分別擷取。</string>
    <string name="guide_selected_input">開始後會將所選音源（%1$s）傳送到辨識服務。</string>
    <string name="guide_microphone_states">懸浮視窗：%1$s\n麥克風：%2$s</string>
    <string name="guide_microphone_steps">請允許懸浮視窗和麥克風權限。僅翻譯麥克風聲音時無需分享螢幕。</string>
    <string name="guide_microphone_trial">說一句簡短的話</string>
    <string name="guide_both_trial">播放一段語音，並對著麥克風說話</string>
    <string name="guide_microphone_trial_hint">開始後會連線至 %1$s，可能產生服務費用。開始後請說幾句話。</string>
    <string name="guide_microphone_start">開始麥克風試用</string>
    <string name="session_history_save">儲存字幕</string>
    <string name="session_history_save_help">預設關閉。開始前開啟，可在儲存上限內將已確認的原文和譯文儲存在本機私人檔案中。停止後可檢視或匯出。關閉會清除目前工作階段已儲存的字幕；以前的工作階段需要手動刪除。不儲存音訊。</string>
    <string name="session_history_title">已儲存的工作階段</string>
    <string name="session_history_help">翻譯停止後，工作階段會顯示在這裡。可分頁檢視字幕，或將原文和譯文匯出為 TXT 或 Markdown，包含音源標記和時間。刪除工作階段會移除對應的本機私人檔案。</string>
    <string name="session_history_empty">還沒有已儲存的字幕。開始工作階段前請開啟「儲存字幕」。</string>
    <string name="session_history_count">%1$d 則字幕</string>
    <string name="session_history_caption_meta">%1$s · %2$s</string>
    <string name="session_history_view">檢視</string>
    <string name="session_history_export">匯出</string>
    <string name="session_history_delete">刪除</string>
    <string name="session_history_delete_confirm">從本機刪除此工作階段？此操作無法復原。</string>
    <string name="session_history_txt">文字（.txt）</string>
    <string name="session_history_markdown">Markdown (.md)</string>
    <string name="session_history_previous">上一頁</string>
    <string name="session_history_next">下一頁</string>
    <string name="session_history_page">第 %1$d 頁</string>
    <string name="session_history_refresh">重新整理</string>
    <string name="session_history_retry">重試</string>
    <string name="session_history_working">處理中…</string>
    <string name="session_history_unavailable">無法讀取已儲存的工作階段。請檢查可用儲存空間後重試。</string>
    <string name="session_history_preference_error">無法儲存此設定，請在開始前重試。</string>
    <string name="session_history_recording_error">部分字幕未能儲存。請停止翻譯、檢查可用空間，再開始新的工作階段。</string>
    <string name="session_history_limit">已達儲存上限，先前儲存的字幕仍可檢視。</string>
    <string name="session_history_deleted">已刪除工作階段</string>
    <string name="session_history_exported">已匯出字幕</string>
    <string name="session_history_delete_error">無法刪除工作階段，請重試。</string>
    <string name="session_history_export_error">無法匯出字幕，請檢查儲存位置後重試。</string>
    <string name="capture_both_no_sound_hint">有一路音源未偵測到聲音，請檢查系統播放和麥克風。</string>
</resources>
